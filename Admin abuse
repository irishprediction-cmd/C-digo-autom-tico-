-- Toggle creator

local function AddToggle(parent, name, key, default)
    Config[key] = default

    local row = Create("Frame", {
        BackgroundColor3 = Theme.Panel,
        Size = UDim2.new(1, 0, 0, 43),
        BorderSizePixel = 0
    }, parent)

    Corner(row, 10)

    Label(
        row, name, 13,
        UDim2.new(0, 12, 0, 0),
        UDim2.new(1, -100, 1, 0)
    )

    local toggle = Button(
        row,
        default and "ON" or "OFF",
        UDim2.new(1, -82, 0, 6),
        UDim2.new(0, 70, 0, 31),
        default and Theme.Green or Theme.Button
    )

    toggle.MouseButton1Click:Connect(function()
        Config[key] = not Config[key]
        toggle.Text = Config[key] and "ON" or "OFF"
        toggle.BackgroundColor3 =
            Config[key] and Theme.Green or Theme.Button
    end)

    return row
end

